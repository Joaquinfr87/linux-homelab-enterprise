# ============================================================
# .env.example — variables de entorno (copiar a .env)
#   cp .env.example .env   y completar los valores.
#   NUNCA versionar .env (está en .gitignore).
# ============================================================

# --- Red / Server (DC) ---
HOST_IP=192.168.0.2            # IP fija del server/DC (cable al router)
DNS_DOMAIN=sudoers.lan          # dominio interno
AD_REALM=SUDOERS.LAN            # realm Kerberos
AD_NETBIOS=SUDOERS              # nombre NetBIOS del dominio
GATEWAY_IP=192.168.0.1          # IP del router (TP-Link TL-WR850N)
# Claves iniciales de AD. install.sh las genera si están vacías y las
# guarda acá (chmod 600) para mostrarlas en el resumen final. No cambies
# AD_ADMIN_PASSWORD después de provisionar; para rotar la del admin:
#   sudo samba-tool user setpassword administrator
AD_ADMIN_PASSWORD=
AD_INITIAL_PASSWORD=

# --- DHCP (Kea, network_mode: host) ---
DHCP_SUBNET=192.168.0.0/24      # red única de la organización
DHCP_POOL=192.168.0.100 - 192.168.0.199
DHCP_DNS=192.168.0.2            # DNS que reciben los clientes (el DC)
DHCP_GATEWAY=192.168.0.1        # puerta de enlace del router
DHCP_NTP=192.168.0.2            # servidor de tiempo (el DC)
# Interfaz donde Kea escucha (host network). Vacío = autodetectar la de la
# ruta por defecto; fijar solo si el server tiene más de una NIC.
DHCP_INTERFACE=

# --- Firewall: IPs extra de administración ---
# La tabla admin_ips de server/nftables.conf ya trae .50–.52. Si te conectás
# por SSH desde otra IP (notebook, WiFi), agregala acá ANTES de deploy.sh o
# el firewall te corta la sesión. bootstrap.sh la completa solo.
ADMIN_IPS_EXTRA=
# Reservas por MAC: "MAC=IP=hostname;MAC2=IP2=hostname2" (IPs .50–.99)
# Después de activar, apagar el DHCP del router TP-Link (Kea lo reemplaza).
DHCP_RESERVATIONS="f8:54:f6:e2:f1:d5=192.168.0.50=pc-joaquin;c8:94:02:10:1e:8b=192.168.0.51=pc-david;14:13:33:15:87:9f=192.168.0.52=pc-nicolas;"

# --- Web / Proxy inverso (Nginx) ---
WEB_SITE_DIR=./services/web/public

# --- Correo (Postfix + Dovecot) ---
MAIL_DOMAIN=mail.sudoers.lan
# Cuentas de correo: "user:pass user2:pass2" (se crean en el contenedor).
# SIN cuentas no hay nadie que pueda entrar al webmail.
# Fase 4: se reemplazan por los usuarios del AD (auth LDAP).
MAIL_USERS="joaquin:CambiarMe1 david:CambiarMe2"

# --- Webmail (Roundcube) ---
ROUNDCUBE_IMAGE_TAG=1.7.4-apache
# Obligatoria: la usa Roundcube para cifrar las sesiones.
# Generar con:  openssl rand -hex 32
ROUNDCUBE_DES_KEY=CambiarEstaClavePorUnaAleatoria

# --- Base de datos (PostgreSQL) ---
DB_PORT=5432
POSTGRES_USER=tso
POSTGRES_PASSWORD=CambiarMePos
POSTGRES_DB=tso

# --- Impresión (CUPS) ---
CUPS_PORT=1631
CUPS_ADMIN_USER=admin
CUPS_ADMIN_PASS=CambiarMe

# --- WiFi WPA2-Enterprise / 802.1X (FreeRADIUS nativo, server/radius) ---
# Secreto compartido RADIUS: DEBE coincidir con el "Radius Server Password"
# de la UI del router (Wireless → Security → WPA/WPA2-Enterprise →
# IP 192.168.0.2, puerto 1812). Obligatorio para server/deploy.sh.
# Generar con:  openssl rand -hex 16
RADIUS_SECRET=

# --- Portainer (panel Docker) ---
PORTAINER_PORT=9443

# --- Monitoreo (Prometheus + Grafana + Alertmanager) ---
PROMETHEUS_TAG=v3.15.0
ALERTMANAGER_TAG=v0.34.1
NODE_EXPORTER_TAG=v1.12.1
CADVISOR_TAG=v0.55.1
BLACKBOX_TAG=v0.28.0
GRAFANA_TAG=13.0.9
# Cuánto guarda Prometheus (series temporales de métricas).
PROMETHEUS_RETENTION=15d
# Login de Grafana (grafana.sudoers.lan).
GRAFANA_ADMIN_USER=admin
# Obligatoria: la pide el compose. Generar con:  openssl rand -base64 18
GRAFANA_ADMIN_PASSWORD=CambiarMeGrafana
# Obligatoria: clave de firmado de Grafana (sesiones/cookies).
# Generar con:  openssl rand -hex 32
GF_SECRET_KEY=CambiarEstaClavePorUnaAleatoria

# --- Backup (restic, nativo — server/backup.sh) ---
# Repo sobre el disco externo montado en /srv/backup (fstab con nofail).
RESTIC_REPOSITORY=/srv/backup/repos/dc1
# Obligatoria: cifra TODO el repo. Si se pierde, se pierde el backup.
# Generar con:  openssl rand -hex 32
RESTIC_PASSWORD=
# Retención: se aplica con restic forget + prune en cada run diario.
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
BACKUP_KEEP_YEARLY=1
# Opcionales (descomentar si hace falta):
# BACKUP_MIN_FREE_KB=1048576   # aborta si el disco baja de esto
# BACKUP_CHECK_SUBSET=10%      # % de datos leídos en el check semanal
# BACKUP_KINIT_USER=backup     # usuario AD para 'samba-tool domain backup online'
# BACKUP_KINIT_PASSWORD=       # sin ticket se usa 'domain backup offline'
# BACKUP_EXTRA_PATHS=          # rutas extra a respaldar ("dir1 dir2")
# BACKUP_STATE_DIR=/var/lib/tso-backup
# BACKUP_LOG=/var/log/tso-backup.log

# --- Archivos (Filebrowser) ---
FILEBROWSER_TAG=v2.63.23
# Clave del administrador de la web (se crea en el primer arranque).
FILES_ADMIN_USER=admin
FILES_ADMIN_PASS=CambiarMeFiles
# Usuarios de la web: mismo formato que MAIL_USERS ("user:pass user2:pass2")
FILES_USERS="joaquin:CambiarMe1 david:CambiarMe2"
# Filebrowser exige claves de >=12 por defecto; con 10 entran las mismas
# claves que usamos en MAIL_USERS (Correo2026).
FILES_MIN_PASS_LEN=10
# gid del grupo que posee los shares (para que los archivos creados desde la
# web sean escribibles por el equipo vía SMB):
#   FILES_GID=$(stat -c %g /srv/samba/departamentos)
FILES_GID=
# Permisos de lo creado desde la web (002 deja escribir al grupo).
FILES_FILE_MODE=0664
FILES_DIR_MODE=0775
FILES_UMASK=002
