% --- Índices ----------------------------------------------------------------
\RequirePackage{tocloft}
\setcounter{tocdepth}{3}
\setcounter{secnumdepth}{3}
% Las secciones se numeran por capítulo (1.10, 2.7, ...), por lo que la
% columna de números del índice debe ser más ancha para evitar desbordes.
\setlength{\cftsecnumwidth}{2.8em}
\setlength{\cftsubsecnumwidth}{3.8em}
\setlength{\cftsubsubsecnumwidth}{4.6em}
% Capítulos en el índice: entrada de nivel "part" en negrita, dos líneas,
% con separación entre capítulos y número de página a la derecha sin puntos.
\renewcommand{\cftpartfont}{\bfseries}
\renewcommand{\cftpartpagefont}{\bfseries}
\setlength{\cftbeforepartskip}{1.5em}
% Títulos de los índices (Índice, Índice de tablas e Índice de figuras)
% centrados.
\renewcommand{\cfttoctitlefont}{\hfill\Large\bfseries}
\renewcommand{\cftaftertoctitle}{\hfill}
\renewcommand{\cftlottitlefont}{\hfill\Large\bfseries}
\renewcommand{\cftafterlottitle}{\hfill}
\renewcommand{\cftloftitlefont}{\hfill\Large\bfseries}
\renewcommand{\cftafterloftitle}{\hfill}
% Prefijo "FIGURA" / "TABLA" en las entradas de los índices de figuras y
% tablas, coherente con las leyendas del cuerpo del documento. Se amplía el
% ancho de la columna del número para acomodar el prefijo sin desbordes.
\renewcommand{\cftfigpresnum}{\textbf{FIGURA }}
\renewcommand{\cfttabpresnum}{\textbf{TABLA }}
\renewcommand{\cftfigaftersnum}{:}
\renewcommand{\cfttabaftersnum}{:}
\setlength{\cftfignumwidth}{7em}
\setlength{\cfttabnumwidth}{7em}

% --- Índices: entradas alineadas a la izquierda y compactas ------------------
% Cada entrada se compone con el texto a la izquierda y el número de página
% alineado a la columna derecha (borde del texto). Se redefinen las macros
% \l@... que lee \contentsline desde los archivos .toc/.lot/.lof.
\makeatletter
\newcommand{\entradaIndice}[2]{%
  \par\noindent
  \begingroup
  \renewcommand{\numberline}[1]{##1\,}%
  \makebox[\linewidth][l]{%
    \parbox[b]{\dimexpr\linewidth-\@pnumwidth-4pt\relax}{\raggedright\strut#1\strut}%
    \hspace{4pt}\hb@xt@\@pnumwidth{\hfil\strut#2}%
  }%
  \endgroup
  \par}
% Variante para figuras y tablas: el número se imprime con dos puntos y un
% espacio (FIGURA 1: <texto> / TABLA 1: <texto>), como en las leyendas.
\newcommand{\entradaIndiceNum}[2]{%
  \par\noindent
  \begingroup
  \renewcommand{\numberline}[1]{##1:\,}%
  \makebox[\linewidth][l]{%
    \parbox[b]{\dimexpr\linewidth-\@pnumwidth-4pt\relax}{\raggedright\strut#1\strut}%
    \hspace{4pt}\hb@xt@\@pnumwidth{\hfil\strut#2}%
  }%
  \endgroup
  \par}
\renewcommand*\l@part[2]{%
  \addvspace{1em}%
  \entradaIndice{\textbf{#1}}{\textbf{#2}}}
\renewcommand*\l@section[2]{\entradaIndice{#1}{#2}}
\renewcommand*\l@subsection[2]{\entradaIndice{#1}{#2}}
\renewcommand*\l@subsubsection[2]{\entradaIndice{#1}{#2}}
\renewcommand*\l@table[2]{\entradaIndiceNum{\textbf{TABLA }\ignorespaces#1}{#2}}
\renewcommand*\l@figure[2]{\entradaIndiceNum{\textbf{FIGURA }\ignorespaces#1}{#2}}
\makeatother
% Interlineado 1.5 y poco espacio entre entradas para los índices.
\newcommand{\indicesCompactos}{%
  \setstretch{1.5}%
  \setlength{\parskip}{1pt}%
}

% --- Hipervínculos -----------------------------------------------------------
\RequirePackage[colorlinks=true, linkcolor=black, urlcolor=blue, citecolor=black]{hyperref}

% --- Referencias en formato APA (paquete apacite) ----------------------------
\RequirePackage[natbibapa]{apacite}

% --- Encabezado de capítulo ---------------------------------------------------
% Uso interno de \caratulaCapitulo y de main.tex (Referencias/Anexos).
% Muestra el nombre del capítulo en mayúsculas y, opcionalmente, el número de
% capítulo (solo en la primera hoja del capítulo). Si el segundo argumento
% viene vacío, se omite el número.
\newcommand{\textoEncabezado}[2]{%
  \parbox{\headwidth}{\raggedleft
    \setstretch{1}%
    \textbf{#1}%
    \\[-6pt]{\rule{\headwidth}{0.4pt}}%
    \if\relax\detokenize{#2}\relax\else\\[2pt]\textbf{#2}\fi
  }%
}
\newcommand{\encabezadoCapitulo}[2]{%
  \fancyhead[C]{\textoEncabezado{#1}{#2}}%
}

% --- Carátula de capítulo (1 hoja completa) -----------------------------------
% Uso: \caratulaCapitulo{CAP\'ITULO I}{INTRODUCCI\'ON}
% Cada capítulo comienza con una página de presentación que ocupa una hoja
% completa. La carátula no muestra número de página ni se cuenta dentro de la
% enumeración (el contador se decrementa tras su salida).
% Las secciones se numeran por capítulo (1.1, 1.2 ... y 2.1, 2.2 ...).
% El encabezado muestra el nombre del capítulo en todas las hojas y el número
% de capítulo únicamente en la primera hoja posterior a la carátula.
\newcounter{capitulo}
\renewcommand{\thesection}{\arabic{capitulo}.\arabic{section}}
% Los anclajes (destinos) de hyperref para los marcadores del PDF deben incluir
% el capítulo igual que los títulos impresos; si no, los capítulos II y III
% reutilizan los mismos identificadores del capítulo I y el esquema del PDF
% se corta (avisos "destination ... duplicate ignored").
\renewcommand{\theHsection}{\arabic{capitulo}.\arabic{section}}
\renewcommand{\theHsubsection}{\theHsection.\arabic{subsection}}
\renewcommand{\theHsubsubsection}{\theHsubsection.\arabic{subsubsection}}
\newcommand{\caratulaCapitulo}[2]{%
  \clearpage
  \refstepcounter{capitulo}%
  \setcounter{section}{0}%
  \pdfbookmark[0]{#1:\ #2}{capitulo.\arabic{capitulo}}%
  \addtocontents{toc}{%
    \protect\contentsline{part}{#1\protect\\#2}{\thepage}{\@currentHref}%
  }%
  \encabezadoCapitulo{#2}{}%
  \fancypagestyle{primeraCap}{%
    \fancyhf{}%
    \fancyfoot[R]{\thepage}%
    \fancyhead[C]{\textoEncabezado{#2}{#1}}%
    \renewcommand{\headrulewidth}{0pt}%
    \renewcommand{\footrulewidth}{0.4pt}%
  }%
  \thispagestyle{empty}%
  \begin{center}
    \vspace*{6.2cm}
    {\bfseries\Huge #1 \par}
    \vspace{1.7cm}
    {\bfseries\LARGE #2 \par}
  \end{center}
  \clearpage
  \addtocounter{page}{-1}%
  \thispagestyle{primeraCap}%
}

