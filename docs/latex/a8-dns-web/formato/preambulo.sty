% ============================================================================
%  PREÁMBULO / FORMATO DEL INFORME  (normas APA · tipografía Arial · A4)
%  ----------------------------------------------------------------------------
%  Este archivo concentra TODOS los paquetes y configuraciones de apariencia.
%  El contenido del informe NO se escribe aquí.
%
%  NOTA SOBRE LA TIPOGRAFÍA:
%  Se usa Helvetica (paquete `helvet`), el sustituto estándar de Arial en LaTeX,
%  porque el paquete `uarial` (fuente Arial URW) fue retirado de TeX Live 2026
%  y de CTAN. Helvetica y Arial son tipografías grotescas prácticamente
%  idénticas, por lo que el resultado visual es equivalente.
%
%  NOTA SOBRE LAS REFERENCIAS:
%  La lista de referencias se genera con el paquete apacite, que sigue la
%  norma APA (sexta edición) para las citas y la bibliografía.
% ============================================================================

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{formato/preambulo}[2026/09/15 Formato APA profesional con Arial, A4]

% --- Idioma y codificación --------------------------------------------------
\RequirePackage[spanish,es-tabla]{babel}
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}

% --- Tipografía Arial (Helvetica a escala visual de 12 pt) ------------------
\RequirePackage[scaled=0.96]{helvet}
\renewcommand{\familydefault}{\sfdefault}

% --- Márgenes de 1 pulgada en papel A4 (APA 7) ------------------------------
\RequirePackage[a4paper,top=1in,bottom=1in,left=1in,right=1in]{geometry}

% --- Interlineado doble (APA 7) ---------------------------------------------
\RequirePackage[doublespacing]{setspace}

% --- Pie de página: línea horizontal y número de página a la derecha ---------
\RequirePackage{fancyhdr}
\setlength{\headheight}{17pt}     % altura para el encabezado (1 línea + regla)
\setlength{\headsep}{25pt}
\pagestyle{fancy}
\fancyhf{}
\fancyfoot[R]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0.4pt}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[R]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0.4pt}%
}

% --- Jerarquía de títulos estilo APA ----------------------------------------
%  Nivel 1 (sección): alineado a la izquierda y en negrita  |  Nivel 2
%  (subsección): alineado a la izquierda y en negrita      |  Nivel 3:
%  izquierda, negrita y cursiva.
\RequirePackage{titlesec}
\titleformat{\section}{\bfseries\Large}{\thesection}{0.6em}{}
\titlespacing*{\section}{0pt}{12pt}{6pt}
\titleformat{\subsection}{\bfseries\large}{\thesubsection}{0.6em}{}
\titlespacing*{\subsection}{0pt}{12pt}{6pt}
\titleformat{\subsubsection}{\bfseries\normalsize\itshape}{\thesubsubsection}{0.6em}{}
\titlespacing*{\subsubsection}{0pt}{6pt}{6pt}

% --- Párrafos: sin sangría, justificados y con un pequeño espaciado entre
% párrafos para mantenerlos diferenciados (APA 7 usa sangría, pero el
% formato del informe exige alineación justificada sin sangría) --------------
\setlength{\parindent}{0pt}
\setlength{\parskip}{6pt}
\setlength{\emergencystretch}{3em}

% --- Tablas y figuras --------------------------------------------------------
\RequirePackage{booktabs}        % tablas profesionales
\RequirePackage{array}           % extensiones de columnas (m{} para centrado vertical)
\RequirePackage{float}           % posicionamiento de flotantes
\setlength{\tabcolsep}{3pt}      % reduce padding para evitar desbordes
\renewcommand{\arraystretch}{1.3}   % espacio vertical entre filas de tablas
\RequirePackage{caption}
% babel (español) reasigna \figurename/\tablename al iniciar el documento;
% por eso la renombración a MAYÚSCULAS debe hacerse después (AtBeginDocument).
\AtBeginDocument{%
  \renewcommand{\figurename}{FIGURA}%
  \renewcommand{\tablename}{TABLA}%
}
\captionsetup{font=small, labelfont=bf, textfont=normal, singlelinecheck=true, skip=6pt}
\captionsetup[table]{labelsep=colon, position=above, justification=centering}
\captionsetup[figure]{labelsep=colon, position=above, justification=centering}

% Entorno para tablas APA: espaciado sencillo y cuerpo en tamaño pequeño.
% El desborde de líneas se evita con \tabcolsep y el ancho de las columnas.
\newenvironment{tablaAPA}{\setstretch{1}\small}{}

% --- Fuente de figuras y tablas ----------------------------------------------
% \contenidoConFuente{<contenido>}{<texto de la fuente>} mide el ancho real del
% contenido (imagen, diagrama TikZ o tabla) y lo coloca en un \parbox centrado,
% con la línea FUENTE debajo, alineada a la izquierda del contenido (a la par,
% no a ras del margen).
\newsavebox{\cajaContenido}
\newcommand{\contenidoConFuente}[2]{%
  \begin{lrbox}{\cajaContenido}#1\end{lrbox}%
  \parbox{\wd\cajaContenido}{%
    \usebox{\cajaContenido}\par
    \vspace{6pt}%
    {\centering\setstretch{1}\footnotesize\textbf{FUENTE:} #2\par}%
  }%
}
% \fuenteAPA{<texto>} para contenido a ancho completo (p. ej. terminal).
\newcommand{\fuenteAPA}[1]{%
  \vspace{4pt}%
  {\centering\setstretch{1}\footnotesize\textbf{FUENTE:} #1\par}%
}

% \figuraAPA{<label>}{<título>}{<contenido>}{<fuente>} coloca el título de la
% figura a lo ancho del texto y la línea FUENTE alineada a la par del título
% (también a ancho del texto), mientras la imagen (o diagrama TikZ) se centra
% al ancho de su propio contenido. Así, el título y la fuente comparten la
% misma alineación y el título no se ve achicado en imágenes estrechas
% (p. ej. capturas de pantalla en orientación vertical). Si <label> viene
% vacío, se omite el \label (caso de figuras sin referencia cruzada).
\newcommand{\figuraAPA}[4]{%
  \begin{lrbox}{\cajaContenido}#3\end{lrbox}%
  % Título a ancho del texto (no se achica en imágenes estrechas)
  \vspace{12pt}%
  \noindent
  \if\relax\detokenize{#1}\relax
    \captionsetup{width=\linewidth}\captionof{figure}{#2}%
  \else
    \captionsetup{width=\linewidth}\captionof{figure}{#2}\label{#1}%
  \fi
  \par
  % Imagen centrada al ancho de su propio contenido
  \begin{center}%
    \parbox{\wd\cajaContenido}{%
      \setstretch{1}%
      \usebox{\cajaContenido}%
    }%
  \end{center}%
  % FUENTE centrada igual que el título (a ancho del texto)
  \vspace{6pt}%
  {\centering\setstretch{1}\footnotesize\textbf{FUENTE:} #4\par}%
}

% --- Gráficos y diagramas ----------------------------------------------------
\RequirePackage{graphicx}
\graphicspath{{figuras/}}   % las imágenes se colocan en la carpeta figuras/

% \capturaAPA{<label>}{<título>}{<archivo.png>}{<descripción de la captura>}
% Muestra la figura si la imagen existe; si no, un recuadro indicativo con la
% descripcion de la captura pendiente y el nombre del archivo esperado.
\newcommand{\capturaAPA}[4]{%
  \begin{lrbox}{\cajaContenido}%
    \IfFileExists{figuras/#3}{%
      \includegraphics[width=0.85\linewidth,height=0.55\textheight,keepaspectratio]{#3}%
    }{%
      \fbox{%
        \begin{minipage}{0.8\linewidth}
          \centering\setstretch{1}%
          \vspace{2.2cm}%
          {\small\textbf{CAPTURA PENDIENTE}\\[4pt]
           \footnotesize Guardar como: \texttt{#3}\\[6pt]
           \footnotesize #4}%
          \vspace{2.2cm}%
        \end{minipage}%
      }%
    }%
  \end{lrbox}%
  \vspace{12pt}%
  \noindent
  \if\relax\detokenize{#1}\relax
    \captionsetup{width=\linewidth}\captionof{figure}{#2}%
  \else
    \captionsetup{width=\linewidth}\captionof{figure}{#2}\label{#1}%
  \fi
  \par
  \begin{center}%
    \parbox{\wd\cajaContenido}{%
      \setstretch{1}%
      \usebox{\cajaContenido}%
    }%
  \end{center}%
  \vspace{6pt}%
  {\centering\setstretch{1}\footnotesize\textbf{FUENTE:} #4\par}%
}
% Escalar figuras automáticamente para que no se salgan del texto
\newsavebox{\imagenBox}
\newcommand{\figuraSegura}[3][0.90]{%
  \begin{lrbox}{\imagenBox}
    \includegraphics[width=\textwidth,height=0.6\textheight,keepaspectratio]{#2}%
  \end{lrbox}
  \ifdim \wd\imagenBox > \textwidth
    \begin{center}
      \resizebox{\textwidth}{!}{\usebox{\imagenBox}}%
    \end{center}
  \else
    \begin{center}
      \usebox{\imagenBox}%
    \end{center}
  \fi
}
