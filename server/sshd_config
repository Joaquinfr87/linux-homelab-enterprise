# ===================================================================
# sshd_config — SSH del servidor (login por CONTRASEÑA, sin claves)
# ===================================================================
# Aplicar en el servidor:
#   sudo bash server/ssh-apply.sh
#   (o dentro del flujo completo: sudo bash server/bootstrap.sh)
#
# Autenticación: SOLO contraseña. Las claves públicas quedan
# deshabilitadas a propósito. Las contraseñas son las del sistema/AD y el
# origen del acceso ya está restringido a `admin_ips` en el firewall
# (server/nftables.conf + ADMIN_IPS_EXTRA en .env).
# ===================================================================

# Mantiene los drop-ins de la distro (cloud-init, etc.) antes de lo nuestro.
Include /etc/ssh/sshd_config.d/*.conf

# ─── Autenticación ───
PermitRootLogin no
PubkeyAuthentication no
PasswordAuthentication yes
KbdInteractiveAuthentication no
PermitEmptyPasswords no
UsePAM yes
MaxAuthTries 3
LoginGraceTime 30

# ─── Usuarios habilitados (admins del dominio) ───
AllowUsers joaquin david nicolas

# ─── Sesión ───
MaxSessions 5
MaxStartups 10:30:60
ClientAliveInterval 300
ClientAliveCountMax 2
# No resolver reverso en el login (si el DNS del DC está caído, no demora).
UseDNS no

# ─── Sin forwarding innecesario ───
AllowTcpForwarding no
AllowAgentForwarding no
X11Forwarding no
PermitTunnel no
GatewayPorts no

# ─── Logging ───
LogLevel VERBOSE
SyslogFacility AUTH

# ─── Puerto y red ───
Port 22
# IP fija del server (la deja server/set-ip.sh). ssh-apply.sh comenta
# automáticamente cualquier ListenAddress que no exista en el host.
ListenAddress 192.168.0.2
