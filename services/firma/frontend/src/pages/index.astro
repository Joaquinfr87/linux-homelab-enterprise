---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Suite de Firma Digital PAdES — UPDS">
  <!-- ESTADO DE CARGA INICIAL DE SESIÓN -->
  <div id="auth-loading-state" class="auth-loading-state">
    <div class="loading-icon-pulse">🛡️</div>
    <div class="loading-text">Conectando con la Suite de Firma Digital...</div>
    <div class="loading-subtext">Seguridad de la Información · UPDS · Red Institucional</div>
  </div>

  <!-- APLICACIÓN PRINCIPAL (VISIBLE PARA TODOS LOS MIEMBROS DE LA RED) -->
  <div id="app-main-content" style="display:none;">
    <!-- NAVEGACIÓN PRINCIPAL: VALIDADOR PÚBLICO + FIRMAR + MI CUENTA -->
    <nav class="main-nav-tabs">
      <button class="nav-btn active" data-tab="verify">
        <span class="nav-icon">🔍</span>
        <span class="nav-text">Validar Firma (Público)</span>
      </button>
      <button class="nav-btn" data-tab="sign">
        <span class="nav-icon">✍️</span>
        <span class="nav-text">Firmar Documento</span>
      </button>
      <button class="nav-btn" data-tab="account">
        <span class="nav-icon">👤</span>
        <span class="nav-text">Mi Certificado & Historial</span>
      </button>
    </nav>

    <!-- ===================================================================== -->
    <!-- VISTA 1: VALIDAR DOCUMENTO (100% PÚBLICO Y LIBRE DE ACCESO EN LA RED) -->
    <!-- ===================================================================== -->
    <section id="tab-verify" class="tab-pane active">
      <!-- BANNER DE VALIDADOR PÚBLICO -->
      <div class="public-verify-banner">
        <div class="pv-icon">🌐</div>
        <div class="pv-content">
          <div class="pv-badge">RED INSTITUCIONAL · VALIDADOR PÚBLICO Y ABIERTO</div>
          <h3 class="pv-title">Módulo de Auditoría Criptográfica PAdES (ISO 32000-2)</h3>
          <p class="pv-desc">
            Cualquier miembro dentro de la red puede verificar la autenticidad, la integridad matemática del archivo,
            los datos completos del firmante (Nombre, Organización, Serie X.509) y el diagnóstico oficial reportado por la plataforma estatal <strong>validar.firmadigital.bo</strong>. No requiere inicio de sesión.
          </p>
        </div>
      </div>

      <div class="section-box" style="margin-top:20px;">
        <div class="section-header">
          <div class="step-num">🔍</div>
          <div>
            <h3>Auditar Documento PDF Firmado</h3>
            <p class="section-desc">
              Sube o arrastra cualquier documento PDF para comprobar sus firmas digitales, titular y estado de no repudio.
            </p>
          </div>
        </div>

        <div class="drop-zone" id="verify-drop-zone">
          <input type="file" id="verify-pdf" accept="application/pdf" class="file-input-hidden" onchange="handleVerifyPdfSelect(event)">
          <div class="drop-content" id="verify-drop-idle">
            <div class="drop-icon">🔍</div>
            <div class="drop-text">
              <strong>Haz clic para examinar</strong> o arrastra el PDF firmado aquí
            </div>
            <div class="drop-hint">Analizador criptográfico PAdES (ISO 32000-2 / RFC 3278)</div>
          </div>
          <div class="drop-file-selected" id="verify-selected-info" style="display:none;">
            <div class="file-icon-pdf">PDF</div>
            <div class="file-meta">
              <div class="file-name" id="verify-pdf-name">documento_firmado.pdf</div>
              <div class="file-size" id="verify-pdf-size">0 KB</div>
            </div>
            <button type="button" class="btn-remove-file" onclick="clearVerifyPdf(event)">✕ Quitar</button>
          </div>
        </div>

        <div class="action-bar" style="margin-top:18px;">
          <button type="button" class="btn-primary-action" id="btn-submit-verify" onclick="executeVerifyPdf()">
            <span class="btn-icon">🔍</span>
            <span class="btn-label">Auditar Documento y Ver Firmante</span>
          </button>
        </div>

        <!-- SIMULADOR DE ALTERACIÓN / TAMPERING PARA PRUEBA DE INTEGRIDAD -->
        <div class="tamper-box" id="tamper-section-box">
          <div class="tamper-header">
            <span class="tamper-icon">🧪</span>
            <div>
              <h4 style="margin:0 0 2px;color:#92400e;font-size:14px;">Simulador de Alteración de PDF (Prueba de Ruptura de Integridad)</h4>
              <p style="margin:0;font-size:12px;color:#b45309;line-height:1.4;">
                Demuestra el principio de no repudio: corrompe intencionalmente 1 solo byte dentro del rango protegido para verificar cómo el sistema local y <strong>validar.firmadigital.bo</strong> detectan inmediatamente que el documento fue alterado.
              </p>
            </div>
          </div>
          <div class="tamper-actions">
            <button type="button" class="btn-tamper-run" id="btn-tamper-run" onclick="executeTamperAndAudit()">
              ⚡ Alterar este PDF y Auditar de inmediato
            </button>
            <button type="button" class="btn-tamper-dl" id="btn-tamper-dl" onclick="executeTamperDownload()">
              ⬇️ Descargar copia alterada (.pdf)
            </button>
          </div>
        </div>
      </div>

      <!-- CONTENEDOR DE RESULTADOS DE AUDITORÍA -->
      <div id="verify-results-container" style="display:none;margin-top:20px;"></div>
    </section>

    <!-- ===================================================================== -->
    <!-- VISTA 2: FIRMAR DOCUMENTO                                             -->
    <!-- ===================================================================== -->
    <section id="tab-sign" class="tab-pane">
      <!-- VISTA PARA USUARIOS CON SESIÓN INICIADA -->
      <div id="sign-active-content" style="display:none;">
        <!-- BARRA DE IDENTIDAD ACTIVA DEL FIRMANTE -->
        <div class="identity-card-active">
          <div class="id-card-left">
            <div class="id-card-icon">🔐</div>
            <div>
              <div class="id-card-title">
                <span>Firmando como:</span>
                <strong id="active-signer-name">Cargando identidad...</strong>
                <span class="badge-tag badge-success">CA Raíz UPDS</span>
              </div>
              <div class="id-card-desc" id="active-signer-desc">
                Certificado X.509 v3 activo · Clave privada custodiada de forma segura
              </div>
            </div>
          </div>
          <button type="button" class="btn-subtle" onclick="goToTab('account')" title="Ver detalles de mi certificado">
            Ver Credencial
          </button>
        </div>

        <!-- PASO 1: SELECCIONAR ARCHIVO PDF -->
        <div class="section-box">
          <div class="section-header">
            <div class="step-num">1</div>
            <div>
              <h3>Documento PDF a Firmar</h3>
              <p class="section-desc">Arrastra o selecciona el archivo PDF que deseas certificar digitalmente.</p>
            </div>
          </div>

          <div class="drop-zone" id="pdf-drop-zone">
            <input type="file" id="sign-pdf" accept="application/pdf" class="file-input-hidden" onchange="handlePdfSelect(event)">
            <div class="drop-content" id="pdf-drop-idle">
              <div class="drop-icon">📄</div>
              <div class="drop-text">
                <strong>Haz clic para examinar</strong> o arrastra tu archivo PDF aquí
              </div>
              <div class="drop-hint">Formato aceptado: .pdf (PAdES / ISO 32000-2)</div>
            </div>
            <div class="drop-file-selected" id="pdf-selected-info" style="display:none;">
              <div class="file-icon-pdf">PDF</div>
              <div class="file-meta">
                <div class="file-name" id="selected-pdf-name">documento.pdf</div>
                <div class="file-size" id="selected-pdf-size">0 KB</div>
              </div>
              <button type="button" class="btn-remove-file" onclick="clearSelectedPdf(event)">✕ Quitar</button>
            </div>
          </div>
        </div>

        <!-- PASO 2: FORMATO Y OPCIONES DE LA FIRMA -->
        <div class="section-box">
          <div class="section-header">
            <div class="step-num">2</div>
            <div>
              <h3>Configuración de la Firma PAdES</h3>
              <p class="section-desc">Define el formato de la firma y el motivo del acto.</p>
            </div>
          </div>

          <!-- TOGGLE FIRMA INVISIBLE VS VISIBLE -->
          <div class="format-choice-grid">
            <label class="format-option">
              <input type="radio" name="sig_visibility" value="invisible" checked onchange="toggleSignatureFormat('invisible')">
              <div class="format-card">
                <span class="format-icon">🔏</span>
                <div>
                  <strong>Firma Criptográfica Invisible (Recomendada)</strong>
                  <p>Incrusta la firma digital directamente en la estructura interna del PDF sin alterar el diseño visual.</p>
                </div>
              </div>
            </label>

            <label class="format-option">
              <input type="radio" name="sig_visibility" value="visible" onchange="toggleSignatureFormat('visible')">
              <div class="format-card">
                <span class="format-icon">🖋️</span>
                <div>
                  <strong>Firma Visible con Estampa & Rúbrica</strong>
                  <p>Estampa un sello visual con tu nombre, fecha, sello de la UPDS y tu rúbrica manuscrita sobre la hoja.</p>
                </div>
              </div>
            </label>
          </div>

          <!-- SECCIÓN DE FIRMA VISIBLE (CONDICIONAL) -->
          <div id="visual-config-box" style="display:none;margin-top:16px;">
            <div class="form-grid-2">
              <div class="form-group">
                <label class="input-label">Posición en la hoja</label>
                <select id="sign-pos" class="form-control" onchange="updatePreviewStamp()">
                  <option value="bottom-right" selected>Inferior Derecha (Predeterminado)</option>
                  <option value="bottom-left">Inferior Izquierda</option>
                  <option value="top-right">Superior Derecha</option>
                  <option value="top-left">Superior Izquierda</option>
                </select>
              </div>
              <div class="form-group">
                <label class="input-label">Página a estampar</label>
                <select id="sign-page" class="form-control">
                  <option value="0" selected>Primera página (Pág. 1)</option>
                  <option value="-1">Última página</option>
                </select>
              </div>
            </div>

            <!-- LIENZO INTERACTIVO DE RÚBRICA MANUSCRITA -->
            <div class="canvas-box">
              <div class="canvas-header">
                <label class="input-label" style="margin:0;">Dibuja tu firma o rúbrica:</label>
                <button type="button" class="btn-link" onclick="clearSignatureCanvas()">Borrar trazo</button>
              </div>
              <div class="canvas-wrapper">
                <canvas id="sig-canvas" width="460" height="120"></canvas>
                <div class="canvas-watermark" id="canvas-watermark">Dibuja aquí con el mouse o dedo</div>
              </div>
              <div class="canvas-footer">
                <span class="canvas-tip">Opcional: Sube una imagen de tu firma (.png transparente):</span>
                <input type="file" id="sig-img-upload" accept="image/png,image/jpeg" style="font-size:12px;" onchange="handleSigImgUpload(event)">
              </div>
            </div>

            <!-- PREVIEW DE LA ESTAMPA -->
            <div class="stamp-preview-container">
              <div class="stamp-preview-title">Previsualización de la estampa en el PDF:</div>
              <div class="stamp-card">
                <div class="stamp-seal">UNIVERSIDAD PRIVADA DOMINGO SAVIO · FIRMA DIGITAL</div>
                <div class="stamp-signer" id="preview-signer">Firmante: ...</div>
                <div class="stamp-reason" id="preview-reason">Motivo: Conformidad técnica</div>
                <div class="stamp-date" id="preview-date">Fecha: ...</div>
                <div class="stamp-hash">Validador: ISO 32000-2 · PAdES CMS</div>
              </div>
            </div>
          </div>

          <!-- METADATOS BÁSICOS -->
          <div class="form-grid-2" style="margin-top:16px;">
            <div class="form-group">
              <label class="input-label">Motivo de la Firma</label>
              <input type="text" id="sign-reason" value="Firma de conformidad técnica (UPDS)" class="form-control">
              <div class="quick-tags">
                <button type="button" class="tag-btn" onclick="setReason('Aprobación de informe académico')">Aprobación académica</button>
                <button type="button" class="tag-btn" onclick="setReason('Firma de conformidad técnica')">Conformidad técnica</button>
                <button type="button" class="tag-btn" onclick="setReason('Revisión de seguridad de la información')">Revisión de seguridad</button>
              </div>
            </div>
            <div class="form-group">
              <label class="input-label">Lugar / Ciudad</label>
              <input type="text" id="sign-loc" value="La Paz, Bolivia" class="form-control">
            </div>
          </div>
        </div>

        <!-- BOTÓN DE FIRMA -->
        <div class="action-bar">
          <button type="button" class="btn-primary-action" id="btn-submit-sign" onclick="executeSignPdf()">
            <span class="btn-icon">✍️</span>
            <span class="btn-label">Firmar Documento con PAdES</span>
          </button>
        </div>

        <!-- TARJETA DE RESULTADO DE FIRMA -->
        <div id="sign-result-card" class="result-card" style="display:none;">
          <div class="result-header">
            <span class="result-icon-badge">✅</span>
            <div>
              <h4 style="margin:0;color:#065f46;font-size:16px;">¡Documento Firmado Exitosamente!</h4>
              <p id="sign-result-text" style="font-size:13px;color:#047857;margin:4px 0 0;">...</p>
            </div>
          </div>
          <div class="result-actions">
            <button type="button" class="btn-subtle" id="btn-download-signed-pdf">⬇️ Descargar nuevamente</button>
            <button type="button" class="btn-primary-action" style="width:auto;padding:8px 16px;font-size:13px;" onclick="goToAuditWithSignedPdf()">
              🔍 Auditar y Validar este documento ahora
            </button>
            <button type="button" class="btn-tamper-run" style="width:auto;padding:8px 16px;font-size:13px;" onclick="tamperSignedPdfAndAudit()">
              🧪 Probar alterador y verificar fallo de integridad
            </button>
          </div>
        </div>
      </div>

      <!-- VISTA CUANDO EL USUARIO NO HA INICIADO SESIÓN (AUTH GATE PARA FIRMA) -->
      <div id="sign-gate-content" style="display:none;">
        <div class="auth-gate-card">
          <div class="auth-gate-hero">
            <span class="auth-gate-badge">🔐 CUENTA DE FIRMANTE REQUERIDA</span>
            <h2>Emisión de Firma Digital Avanzada</h2>
            <p>
              Para emitir tu par de claves criptográficas RSA 2048 y firmar documentos PDF con tu
              Certificado Institucional X.509, <strong>inicia sesión o crea tu cuenta</strong>.
            </p>
            <div class="public-notice-pill">
              💡 <strong>Nota:</strong> Si solo deseas comprobar la validez de un documento firmado, el 
              <a href="javascript:void(0)" onclick="goToTab('verify')" style="color:#0f3d6e;font-weight:700;text-decoration:underline;">Validador de Firmas es 100% público</a> y abierto para toda la red.
            </div>
          </div>

          <!-- SELECTOR DE PESTAÑA: LOGIN / REGISTRO -->
          <div class="auth-switch-bar">
            <button type="button" class="auth-switch-btn active" id="gate-btn-login" onclick="switchGateTab('login')">
              🔑 Iniciar Sesión
            </button>
            <button type="button" class="auth-switch-btn" id="gate-btn-register" onclick="switchGateTab('register')">
              ✨ Crear Cuenta & Emitir Certificado
            </button>
          </div>

          <!-- FORMULARIO DE INICIO DE SESIÓN -->
          <div id="gate-panel-login" class="gate-panel active">
            <form onsubmit="handleGateLogin(event)" class="gate-form">
              <div class="form-group">
                <label class="input-label">Correo Institucional / Personal <span class="req">*</span></label>
                <input type="email" id="gate-login-email" required placeholder="ejemplo@upds.edu.bo" class="form-control" autocomplete="email">
              </div>
              <div class="form-group" style="margin-top:14px;">
                <label class="input-label">Contraseña <span class="req">*</span></label>
                <input type="password" id="gate-login-password" required placeholder="Tu contraseña" class="form-control" autocomplete="current-password">
              </div>

              <button type="submit" class="btn-primary-action" id="btn-gate-login" style="margin-top:20px;">
                <span class="btn-icon">🚀</span>
                <span class="btn-label">Ingresar y Desbloquear Firma</span>
              </button>
            </form>
          </div>

          <!-- FORMULARIO DE REGISTRO -->
          <div id="gate-panel-register" class="gate-panel" style="display:none;">
            <div class="pki-mini-banner">
              <span class="pki-mini-icon">🏛️</span>
              <div>
                <strong>Emisión Criptográfica Institucional:</strong>
                Al registrarte, la Autoridad Certificadora (CA Raíz UPDS) generará tu par de claves RSA 2048 y emitirá tu Certificado X.509 v3 oficial.
              </div>
            </div>

            <form onsubmit="handleGateRegister(event)" class="gate-form">
              <div class="form-grid-2">
                <div class="form-group">
                  <label class="input-label">Nombre Completo <span class="req">*</span></label>
                  <input type="text" id="gate-reg-name" required placeholder="Ej. Juan Pérez" class="form-control" autocomplete="name">
                  <span class="form-tip">Nombre que constará en tu firma digital.</span>
                </div>
                <div class="form-group">
                  <label class="input-label">Correo Electrónico <span class="req">*</span></label>
                  <input type="email" id="gate-reg-email" required placeholder="juan.perez@upds.edu.bo" class="form-control" autocomplete="email">
                </div>
              </div>

              <div class="form-grid-2">
                <div class="form-group">
                  <label class="input-label">Contraseña <span class="req">*</span></label>
                  <input type="password" id="gate-reg-password" required minlength="6" placeholder="Mínimo 6 caracteres" class="form-control" autocomplete="new-password">
                </div>
                <div class="form-group">
                  <label class="input-label">Facultad / Unidad</label>
                  <input type="text" id="gate-reg-unit" value="Seguridad Informatica" class="form-control">
                </div>
              </div>

              <div class="form-grid-2">
                <div class="form-group">
                  <label class="input-label">Sede / Ciudad</label>
                  <input type="text" id="gate-reg-city" value="La Paz" class="form-control">
                </div>
                <div class="form-group">
                  <label class="input-label">Organización Emisora</label>
                  <input type="text" id="gate-reg-org" value="Universidad Privada Domingo Savio" class="form-control" readonly>
                </div>
              </div>

              <button type="submit" class="btn-primary-action" id="btn-gate-register" style="margin-top:20px;">
                <span class="btn-icon">⚡</span>
                <span class="btn-label">Crear Cuenta & Emitir Certificado X.509</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================================================================== -->
    <!-- VISTA 3: MI CERTIFICADO & HISTORIAL                                   -->
    <!-- ===================================================================== -->
    <section id="tab-account" class="tab-pane">
      <!-- VISTA PARA USUARIOS CON SESIÓN INICIADA -->
      <div id="account-active-content" style="display:none;">
        <!-- PERFIL DEL USUARIO -->
        <div class="profile-card">
          <div class="profile-left">
            <div class="profile-avatar" id="auth-avatar-text">UP</div>
            <div class="profile-info">
              <div class="profile-name-row">
                <h2 id="auth-user-name">Usuario</h2>
                <span class="badge-tag badge-success">Certificado Activo</span>
              </div>
              <div class="profile-meta-row">
                <span id="auth-user-email">...</span> · 
                <span id="auth-user-unit">...</span> · 
                <span id="auth-user-city">...</span>
              </div>
            </div>
          </div>
          <button type="button" class="btn-logout" onclick="handleLogout()" title="Cerrar sesión actual">
            🚪 Cerrar Sesión
          </button>
        </div>

        <!-- CARNET DIGITAL CRIPTOGRÁFICO X.509 -->
        <div class="section-box" style="margin-top:20px;">
          <div class="section-header">
            <div class="step-num">🛡️</div>
            <div>
              <h3>Certificado Digital Institucional X.509 v3</h3>
              <p class="section-desc">Identidad criptográfica oficial expedida por la Autoridad Certificadora Raíz UPDS.</p>
            </div>
          </div>

          <div class="cert-diploma-card">
            <div class="cert-diploma-header">
              <div class="cert-diploma-title">
                <span>REPÚBLICA DE BOLIVIA · UNIVERSIDAD PRIVADA DOMINGO SAVIO</span>
                <h4>CERTIFICADO DE FIRMA DIGITAL ELECTRÓNICA AVANZADA (PAdES)</h4>
              </div>
              <div class="cert-diploma-seal">UPDS CA</div>
            </div>

            <div class="cert-diploma-body">
              <div class="diploma-grid">
                <div class="diploma-item">
                  <span class="diploma-lbl">Titular de la Credencial (Common Name):</span>
                  <span class="diploma-val" id="cert-cn-val">...</span>
                </div>
                <div class="diploma-item">
                  <span class="diploma-lbl">Correo Electrónico:</span>
                  <span class="diploma-val" id="cert-email-val">...</span>
                </div>
                <div class="diploma-item">
                  <span class="diploma-lbl">Autoridad Emisora (Issuer CA):</span>
                  <span class="diploma-val" style="color:var(--primary);font-weight:700;">Autoridad Certificadora Raiz UPDS</span>
                </div>
                <div class="diploma-item">
                  <span class="diploma-lbl">Algoritmo & Parámetros:</span>
                  <span class="diploma-val">RSA 2048 bits · Resumen SHA-256 · ISO 32000-2</span>
                </div>
                <div class="diploma-item">
                  <span class="diploma-lbl">Número de Serie (Hexadecimal):</span>
                  <code class="diploma-code" id="cert-serial-val">...</code>
                </div>
                <div class="diploma-item">
                  <span class="diploma-lbl">Huella Criptográfica (SHA-256 Fingerprint):</span>
                  <code class="diploma-code" id="cert-fp-val">...</code>
                </div>
                <div class="diploma-item">
                  <span class="diploma-lbl">Vigencia del Certificado:</span>
                  <span class="diploma-val" id="cert-validity-val">...</span>
                </div>
                <div class="diploma-item">
                  <span class="diploma-lbl">Custodia de la Clave Privada:</span>
                  <span class="diploma-val" style="color:#059669;font-weight:700;">🔒 Almacenada con cifrado simétrico AES-256 en reposo</span>
                </div>
              </div>
            </div>

            <div class="cert-diploma-footer">
              <a href="/api/auth/download_p12" class="btn-download-cert" id="btn-dl-p12">
                📦 Descargar Contenedor PKCS#12 (.p12)
              </a>
              <a href="/api/auth/download_cert" class="btn-download-cert" id="btn-dl-crt">
                📜 Descargar Certificado (.crt)
              </a>
              <a href="/api/auth/download_ca" class="btn-download-cert" id="btn-dl-ca">
                🏛️ Descargar CA Raíz UPDS (.crt)
              </a>
            </div>
          </div>
        </div>

        <!-- HISTORIAL Y BITÁCORA DE DOCUMENTOS FIRMADOS -->
        <div class="section-box" style="margin-top:20px;">
          <div class="section-header">
            <div class="step-num">📋</div>
            <div>
              <h3>Historial de Documentos Firmados (Auditoría)</h3>
              <p class="section-desc">Trazabilidad inmutable de todas las firmas digitales generadas con tu cuenta.</p>
            </div>
          </div>

          <div id="audit-table-container">
