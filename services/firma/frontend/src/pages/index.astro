  <!-- LÓGICA DE INTERACCIÓN CLIENTE -->
  <script is:inline>
    // Variables de estado
    let currentUser = null;
    let selectedPdfFile = null;
    let selectedVerifyPdfFile = null;
    let signedPdfBlob = null;
    let signedPdfFileName = 'documento_firmado.pdf';
    let currentSigVisibility = 'invisible';

    // Canvas de firma
    const canvas = document.getElementById('sig-canvas');
    const ctx = canvas ? canvas.getContext('2d') : null;
    let isDrawing = false;
    let hasDrawnSignature = false;

    function initCanvas() {
      if (!canvas || !ctx) return;
      ctx.strokeStyle = '#0f3d6e';
      ctx.lineWidth = 2.5;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';

      function getPos(e) {
        const rect = canvas.getBoundingClientRect();
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        return {
          x: (clientX - rect.left) * (canvas.width / rect.width),
          y: (clientY - rect.top) * (canvas.height / rect.height)
        };
      }

      function startDraw(e) {
        isDrawing = true;
        const pos = getPos(e);
        ctx.beginPath();
        ctx.moveTo(pos.x, pos.y);
        document.getElementById('canvas-watermark').style.display = 'none';
        hasDrawnSignature = true;
        e.preventDefault();
      }

      function draw(e) {
        if (!isDrawing) return;
        const pos = getPos(e);
        ctx.lineTo(pos.x, pos.y);
        ctx.stroke();
        e.preventDefault();
      }

      function stopDraw() { isDrawing = false; }

      canvas.addEventListener('mousedown', startDraw);
      canvas.addEventListener('mousemove', draw);
      window.addEventListener('mouseup', stopDraw);

      canvas.addEventListener('touchstart', startDraw, { passive: false });
      canvas.addEventListener('touchmove', draw, { passive: false });
      window.addEventListener('touchend', stopDraw);
    }

    function clearSignatureCanvas() {
      if (!ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      document.getElementById('canvas-watermark').style.display = 'block';
      hasDrawnSignature = false;
      document.getElementById('sig-img-upload').value = '';
    }

    function handleSigImgUpload(e) {
      const file = e.target.files[0];
      if (!file) return;
      const img = new Image();
      img.onload = () => {
        clearSignatureCanvas();
        document.getElementById('canvas-watermark').style.display = 'none';
        ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
        hasDrawnSignature = true;
        window.showToast('Sello Cargado', 'Imagen integrada a la estampa.', 'info');
      };
      img.src = URL.createObjectURL(file);
    }

    // Navegación de pestañas principales (Firmar, Validar, Mi Certificado)
    function goToTab(tabName) {
      document.querySelectorAll('.nav-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));
      const btn = document.querySelector(`.nav-btn[data-tab="${tabName}"]`);
      if (btn) btn.classList.add('active');
      const tab = document.getElementById('tab-' + tabName);
      if (tab) tab.classList.add('active');
    }

    document.querySelectorAll('.nav-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const tabName = btn.getAttribute('data-tab');
        goToTab(tabName);
      });
    });

    // Subpestañas del Auth Gate (Login vs Registro)
    function switchGateTab(mode) {
      document.getElementById('gate-btn-login').classList.toggle('active', mode === 'login');
      document.getElementById('gate-btn-register').classList.toggle('active', mode === 'register');
      document.getElementById('gate-panel-login').style.display = (mode === 'login') ? 'block' : 'none';
      document.getElementById('gate-panel-register').style.display = (mode === 'register') ? 'block' : 'none';
    }

    // Toggle de visibilidad de firma (Invisible vs Visible)
    function toggleSignatureFormat(format) {
      currentSigVisibility = format;
      const visualBox = document.getElementById('visual-config-box');
      visualBox.style.display = (format === 'visible') ? 'block' : 'none';
      if (format === 'visible') {
        updatePreviewStamp();
      }
    }

    function setReason(reason) {
      document.getElementById('sign-reason').value = reason;
      updatePreviewStamp();
    }

    function updatePreviewStamp() {
      const signer = currentUser ? currentUser.full_name : 'Estudiante UPDS';
      const reason = document.getElementById('sign-reason').value || 'Conformidad técnica';
      const loc = document.getElementById('sign-loc').value || 'La Paz, BO';
      document.getElementById('preview-signer').textContent = 'Firmante: ' + signer;
      document.getElementById('preview-reason').textContent = 'Motivo: ' + reason;
      document.getElementById('preview-date').textContent = 'Fecha: ' + new Date().toLocaleDateString() + ' · ' + loc;
    }

    // Drag and Drop para PDF a firmar
    const dropZone = document.getElementById('pdf-drop-zone');
    ['dragenter', 'dragover'].forEach(name => {
      dropZone.addEventListener(name, (e) => { e.preventDefault(); dropZone.classList.add('dragover'); });
    });
    ['dragleave', 'drop'].forEach(name => {
      dropZone.addEventListener(name, (e) => { e.preventDefault(); dropZone.classList.remove('dragover'); });
    });
    dropZone.addEventListener('drop', (e) => {
      if (e.dataTransfer.files && e.dataTransfer.files[0]) {
        applyPdfFile(e.dataTransfer.files[0]);
      }
    });

    function handlePdfSelect(e) {
      if (e.target.files && e.target.files[0]) {
        applyPdfFile(e.target.files[0]);
      }
    }

    function applyPdfFile(file) {
      if (!file.name.toLowerCase().endsWith('.pdf')) {
        window.showToast('Formato Inválido', 'Solo se admiten documentos en formato PDF.', 'error');
        return;
      }
      selectedPdfFile = file;
      document.getElementById('selected-pdf-name').textContent = file.name;
      document.getElementById('selected-pdf-size').textContent = (file.size / 1024).toFixed(1) + ' KB';
      document.getElementById('pdf-drop-idle').style.display = 'none';
      document.getElementById('pdf-selected-info').style.display = 'flex';
    }

    function clearSelectedPdf(e) {
      if (e) e.stopPropagation();
      selectedPdfFile = null;
      document.getElementById('sign-pdf').value = '';
      document.getElementById('pdf-drop-idle').style.display = 'block';
      document.getElementById('pdf-selected-info').style.display = 'none';
      document.getElementById('sign-result-card').style.display = 'none';
    }

    // Drag and Drop para PDF a auditar
    const verifyDropZone = document.getElementById('verify-drop-zone');
    ['dragenter', 'dragover'].forEach(name => {
      verifyDropZone.addEventListener(name, (e) => { e.preventDefault(); verifyDropZone.classList.add('dragover'); });
    });
    ['dragleave', 'drop'].forEach(name => {
      verifyDropZone.addEventListener(name, (e) => { e.preventDefault(); verifyDropZone.classList.remove('dragover'); });
    });
    verifyDropZone.addEventListener('drop', (e) => {
      if (e.dataTransfer.files && e.dataTransfer.files[0]) {
        applyVerifyPdfFile(e.dataTransfer.files[0]);
      }
    });

    function handleVerifyPdfSelect(e) {
      if (e.target.files && e.target.files[0]) {
        applyVerifyPdfFile(e.target.files[0]);
      }
    }

    function applyVerifyPdfFile(file) {
      if (!file.name.toLowerCase().endsWith('.pdf')) {
        window.showToast('Formato Inválido', 'Solo se admiten archivos PDF.', 'error');
        return;
      }
      selectedVerifyPdfFile = file;
      document.getElementById('verify-pdf-name').textContent = file.name;
      document.getElementById('verify-pdf-size').textContent = (file.size / 1024).toFixed(1) + ' KB';
      document.getElementById('verify-drop-idle').style.display = 'none';
      document.getElementById('verify-selected-info').style.display = 'flex';
      document.getElementById('verify-results-container').style.display = 'none';
    }

    function clearVerifyPdf(e) {
      if (e) e.stopPropagation();
      selectedVerifyPdfFile = null;
      document.getElementById('verify-pdf').value = '';
      document.getElementById('verify-drop-idle').style.display = 'block';
      document.getElementById('verify-selected-info').style.display = 'none';
      document.getElementById('verify-results-container').style.display = 'none';
    }

    // AUTENTICACIÓN: VERIFICAR ESTADO
    async function checkUserAuth() {
      try {
        const res = await fetch('/api/auth/me');
        const data = await res.json();
        if (data.authenticated && data.user) {
          currentUser = data.user;
          renderAuthenticatedUser(currentUser);
        } else {
          currentUser = null;
          renderAnonymousUser();
        }
      } catch (e) {
        currentUser = null;
        renderAnonymousUser();
      }
    }

    function renderAuthenticatedUser(user) {
      const loadingEl = document.getElementById('auth-loading-state');
      if (loadingEl) loadingEl.style.display = 'none';
      const mainEl = document.getElementById('app-main-content');
      if (mainEl) mainEl.style.display = 'block';

      // Alternar secciones activas vs auth gate
      const signActive = document.getElementById('sign-active-content');
      if (signActive) signActive.style.display = 'block';
      const signGate = document.getElementById('sign-gate-content');
      if (signGate) signGate.style.display = 'none';

      const accountActive = document.getElementById('account-active-content');
      if (accountActive) accountActive.style.display = 'block';
      const accountGate = document.getElementById('account-gate-content');
      if (accountGate) accountGate.style.display = 'none';

      // Cabecera superior
      const headerPill = document.getElementById('user-header-pill');
      if (headerPill) {
        const initials = user.full_name ? user.full_name.split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase() : 'UP';
        headerPill.innerHTML = `
          <div class="user-pill-logged" onclick="goToTab('account')" title="Ver mi certificado e historial" style="cursor:pointer;display:inline-flex;align-items:center;gap:8px;padding:5px 12px;background:#eff6ff;border:1px solid #bfdbfe;border-radius:999px;font-size:12px;font-weight:700;color:#0f3d6e;">
            <span class="user-avatar-tiny" style="background:#0f3d6e;color:#fff;border-radius:50%;width:22px;height:22px;display:inline-flex;align-items:center;justify-content:center;font-size:10px;">${initials}</span>
            <span>${escapeHtml(user.full_name)}</span>
          </div>
          <button type="button" class="btn-logout" onclick="handleLogout()" title="Cerrar sesión" style="margin-left:6px;background:none;border:none;color:#dc2626;font-size:12px;font-weight:700;cursor:pointer;">Salir</button>
        `;
      }

      // Identidad en la pestaña de firma
      const activeSignerName = document.getElementById('active-signer-name');
      if (activeSignerName) activeSignerName.textContent = user.full_name;
      const activeSignerDesc = document.getElementById('active-signer-desc');
      if (activeSignerDesc) {
        activeSignerDesc.textContent = 
          `${user.email} · Serie: ${(user.serial_hex || '').substring(0, 16)}... · Válido hasta: ${(user.valid_to || '').substring(0, 10)}`;
      }

      // Pestaña Mi Certificado
      const initials = user.full_name ? user.full_name.split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase() : 'UP';
      const avatarEl = document.getElementById('auth-avatar-text');
      if (avatarEl) avatarEl.textContent = initials;
      const userNameEl = document.getElementById('auth-user-name');
      if (userNameEl) userNameEl.textContent = user.full_name;
      const userEmailEl = document.getElementById('auth-user-email');
      if (userEmailEl) userEmailEl.textContent = user.email;
      const userUnitEl = document.getElementById('auth-user-unit');
      if (userUnitEl) userUnitEl.textContent = user.unit || 'Seguridad Informática';
      const userCityEl = document.getElementById('auth-user-city');
      if (userCityEl) userCityEl.textContent = `${user.city || 'La Paz'}, ${user.country || 'BO'}`;

      const cnVal = document.getElementById('cert-cn-val');
      if (cnVal) cnVal.textContent = user.full_name;
      const emailVal = document.getElementById('cert-email-val');
      if (emailVal) emailVal.textContent = user.email;
      const serialVal = document.getElementById('cert-serial-val');
      if (serialVal) serialVal.textContent = user.serial_hex;
      const fpVal = document.getElementById('cert-fp-val');
      if (fpVal) fpVal.textContent = user.fingerprint_sha256;
      const valVal = document.getElementById('cert-validity-val');
      if (valVal) {
        valVal.textContent = `${(user.valid_from || '').substring(0, 10)} hasta ${(user.valid_to || '').substring(0, 10)}`;
      }

      updatePreviewStamp();
      loadUserAuditLogs();
    }

    function renderAnonymousUser() {
      const loadingEl = document.getElementById('auth-loading-state');
      if (loadingEl) loadingEl.style.display = 'none';
      const mainEl = document.getElementById('app-main-content');
      if (mainEl) mainEl.style.display = 'block';

      // Ocultar contenidos restringidos y mostrar carteles de acceso
      const signActive = document.getElementById('sign-active-content');
      if (signActive) signActive.style.display = 'none';
      const signGate = document.getElementById('sign-gate-content');
      if (signGate) signGate.style.display = 'block';

      const accountActive = document.getElementById('account-active-content');
      if (accountActive) accountActive.style.display = 'none';
      const accountGate = document.getElementById('account-gate-content');
      if (accountGate) accountGate.style.display = 'block';

      const headerPill = document.getElementById('user-header-pill');
      if (headerPill) {
        headerPill.innerHTML = `
          <button type="button" onclick="goToTab('sign')" class="btn-subtle" style="cursor:pointer;display:inline-flex;align-items:center;gap:6px;padding:6px 14px;background:#f8fafc;border:1px solid #cbd5e1;border-radius:999px;font-size:12px;font-weight:700;color:#0f3d6e;">
            <span>🔑 Iniciar Sesión / Registro</span>
          </button>
        `;
      }
    }

    async function handleGateRegister(e) {
      e.preventDefault();
      const btn = document.getElementById('btn-gate-register');
      btn.disabled = true;
      btn.innerHTML = '<span class="btn-icon">⏳</span><span class="btn-label">Generando RSA 2048 y emitiendo certificado CA...</span>';

      const payload = {
        full_name: document.getElementById('gate-reg-name').value,
        email: document.getElementById('gate-reg-email').value,
        password: document.getElementById('gate-reg-password').value,
        unit: document.getElementById('gate-reg-unit').value,
        city: document.getElementById('gate-reg-city').value,
        organization: document.getElementById('gate-reg-org').value,
      };

      try {
        const res = await fetch('/api/auth/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          throw new Error(data.error || 'Fallo en el registro');
        }

        window.showToast('¡Cuenta Creada!', 'Certificado emitido por CA UPDS. Plataforma desbloqueada.', 'success', 5000);
        await checkUserAuth();
      } catch (err) {
        window.showToast('Error de Registro', err.message, 'error', 5000);
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<span class="btn-icon">⚡</span><span class="btn-label">Crear Cuenta & Emitir Certificado X.509</span>';
      }
    }

    async function handleGateLogin(e) {
      e.preventDefault();
      const btn = document.getElementById('btn-gate-login');
      btn.disabled = true;
      btn.innerHTML = '<span class="btn-icon">⏳</span><span class="btn-label">Verificando credenciales...</span>';

      const payload = {
        email: document.getElementById('gate-login-email').value,
        password: document.getElementById('gate-login-password').value,
      };

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (!res.ok || !data.ok) {
          throw new Error(data.error || 'Credenciales inválidas');
        }

        window.showToast('Acceso Autorizado', 'Bienvenido a la suite UPDS.', 'success');
        await checkUserAuth();
      } catch (err) {
        window.showToast('Error de Acceso', err.message, 'error', 5000);
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<span class="btn-icon">🚀</span><span class="btn-label">Ingresar a la Plataforma</span>';
      }
    }

    async function handleLogout() {
      try {
        await fetch('/api/auth/logout', { method: 'POST' });
        window.showToast('Sesión Finalizada', 'Has cerrado sesión correctamente.', 'info');
        currentUser = null;
        renderAnonymousUser();
      } catch (e) {
        window.showToast('Error', 'Fallo al cerrar sesión', 'error');
      }
    }

    // EJECUTAR FIRMA DIGITAL PAdES
    async function executeSignPdf() {
      if (!selectedPdfFile) {
        window.showToast('Falta Documento', 'Por favor selecciona un archivo PDF para firmar.', 'warning');
        return;
      }

      const btn = document.getElementById('btn-submit-sign');
      btn.disabled = true;
      btn.innerHTML = '<span class="btn-icon">⏳</span><span class="btn-label">Firmando documento PAdES...</span>';

      const fd = new FormData();
      fd.append('pdf', selectedPdfFile);
      fd.append('cert_mode', 'account');
      fd.append('contact', currentUser ? currentUser.full_name : 'Estudiante UPDS');
      fd.append('reason', document.getElementById('sign-reason').value);
      fd.append('location', document.getElementById('sign-loc').value);
      fd.append('hash_algo', 'sha256');

      const isVisual = (currentSigVisibility === 'visible');
      fd.append('visual_signature', isVisual ? 'true' : 'false');
      if (isVisual) {
        fd.append('sigpage', document.getElementById('sign-page').value);
        fd.append('visual_position', document.getElementById('sign-pos').value);
        if (hasDrawnSignature) {
          fd.append('signature_image_b64', canvas.toDataURL('image/png'));
        }
      }

      try {
        const res = await fetch('/api/sign', { method: 'POST', body: fd });
        if (res.status === 401) {
          window.showToast('Acceso Denegado (401)', 'Middleware: Debes iniciar sesión para firmar.', 'error', 5000);
          renderAnonymousUser();
          return;
        }
        if (!res.ok) {
          const err = await res.json().catch(() => ({ error: 'Error del servidor' }));
          throw new Error(err.error || 'Fallo en la firma');
        }

        const blob = await res.blob();
        signedPdfBlob = blob;
        const origBase = selectedPdfFile.name.replace(/\.[^/.]+$/, "");
        signedPdfFileName = origBase + '_firmado_pades.pdf';

        // Auto-descargar
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = signedPdfFileName;
        a.click();
        URL.revokeObjectURL(url);

        document.getElementById('sign-result-text').textContent = 
          `Se generó "${signedPdfFileName}" (${(blob.size / 1024).toFixed(1)} KB) con firma PAdES ISO 32000-2 y cadena de confianza CA UPDS.`;
        document.getElementById('sign-result-card').style.display = 'block';

        document.getElementById('btn-download-signed-pdf').onclick = () => {
          const u = URL.createObjectURL(signedPdfBlob);
          const dl = document.createElement('a');
          dl.href = u;
          dl.download = signedPdfFileName;
          dl.click();
          URL.revokeObjectURL(u);
        };

        window.showToast('¡Firma Completada!', 'El PDF firmado ha sido descargado automáticamente.', 'success');
        loadUserAuditLogs();
      } catch (err) {
        window.showToast('Error de Firma', err.message, 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<span class="btn-icon">✍️</span><span class="btn-label">Firmar Documento con PAdES</span>';
      }
    }

    function goToAuditWithSignedPdf() {
      if (!signedPdfBlob) return;
      const file = new File([signedPdfBlob], signedPdfFileName, { type: 'application/pdf' });
      applyVerifyPdfFile(file);
      goToTab('verify');
      executeVerifyPdf();
    }

    // AUDITAR / VALIDAR PDF (PÚBLICO Y ACCESIBLE DESDE CUALQUIER NODO EN LA RED)
    async function executeVerifyPdf() {
      if (!selectedVerifyPdfFile) {
        window.showToast('Falta Documento', 'Por favor selecciona un PDF firmado para auditar.', 'warning');
        return;
      }

      const btn = document.getElementById('btn-submit-verify');
      btn.disabled = true;
      btn.innerHTML = '<span class="btn-icon">⏳</span><span class="btn-label">Auditando criptografía PAdES y consultando validar.firmadigital.bo...</span>';

      const fd = new FormData();
      fd.append('pdf', selectedVerifyPdfFile);

      const container = document.getElementById('verify-results-container');
      container.innerHTML = '';
      container.style.display = 'none';

      try {
        const res = await fetch('/api/verify', { method: 'POST', body: fd });
        if (res.status === 401) {
          window.showToast('Acceso Denegado (401)', 'Error inesperado: La validación es pública.', 'error', 5000);
          return;
        }
        const j = await res.json();
        if (!res.ok || !j.ok) {
          throw new Error(j.error || 'Error al validar el documento');
        }

        if (!j.has_signatures || j.signatures.length === 0) {
          container.innerHTML = `
            <div class="audit-card" style="border-left: 4px solid #d97706; padding: 20px;">
              <h4 style="color:#d97706;margin:0 0 6px;font-size:16px;">⚠️ Sin Firmas Digitales Detectadas</h4>
              <p style="font-size:13px;color:#64748b;margin:0;line-height:1.5;">
                El archivo analizado no contiene diccionarios de firma digital PAdES (<code>/Sig</code> con <code>/ByteRange</code>) o es un documento PDF estándar sin certificar.
              </p>
            </div>
          `;
        } else {
          let html = `
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;flex-wrap:wrap;gap:10px;">
              <h4 style="color:var(--primary);font-size:16px;margin:0;display:flex;align-items:center;gap:8px;">
                <span>🛡️ Firmas Digitales Verificadas:</span>
                <span class="badge-tag badge-info" style="font-size:13px;">${j.signatures.length} ${j.signatures.length === 1 ? 'firma' : 'firmas'}</span>
              </h4>
              <span style="font-size:12px;color:var(--text-muted);">
                ${j.official_service_reachable ? '🌐 Conectado con validar.firmadigital.bo' : '🔒 Auditoría criptográfica local completada'}
              </span>
            </div>
          `;

          j.signatures.forEach(s => {
            const cert = s.cert || {};
            const meta = s.meta || {};
            const adsib = s.official_adsib;
            const signerName = s.signer_name || cert.common_name || meta.name || 'Firmante';
            const initials = signerName.split(' ').map(n => n[0]).slice(0, 2).join('').toUpperCase();

            // Status border and badges
            const isCorrupted = !s.integrity;
            const borderColor = isCorrupted ? '#ef4444' : (s.signature && s.trusted ? '#10b981' : '#f59e0b');
            const badgeClass = isCorrupted ? 'badge-danger' : (s.signature ? 'badge-success' : 'badge-danger');
            const badgeText = isCorrupted ? '❌ DOCUMENTO ALTERADO' : (s.signature ? '✅ DOCUMENTO ÍNTEGRO' : '❌ FIRMA CORRUPTA');

            html += `
              <div class="audit-card" style="border-left: 5px solid ${borderColor}; margin-bottom: 24px; padding: 22px;">
                <!-- ENCABEZADO DE LA FIRMA -->
                <div class="sig-header-bar" style="display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;border-bottom:1px solid var(--border);padding-bottom:12px;margin-bottom:16px;">
                  <div class="sig-header-left">
                    <span class="sig-num-badge">Firma #${s.index}</span>
                    <span class="sig-tech-pill">Estándar PAdES · ISO 32000-2 · adbe.pkcs7.detached</span>
                  </div>
                  <div>
                    <span class="badge-tag ${badgeClass}" style="font-size:12px;padding:6px 14px;font-weight:800;">${badgeText}</span>
                  </div>
                </div>

                <!-- TARJETA DESTACADA DEL FIRMANTE -->
                <div class="signer-highlight-card" style="${isCorrupted ? 'background:#fef2f2;border-color:#fecaca;' : ''}">
                  <div class="signer-avatar" style="${isCorrupted ? 'background:#fee2e2;color:#991b1b;' : ''}">${initials}</div>
                  <div style="flex:1;">
                    <div class="signer-label-tag" style="${isCorrupted ? 'color:#b91c1c;' : ''}">Titular y Signatario Reconocido:</div>
                    <div class="signer-title-name">${escapeHtml(signerName)}</div>
                    <div class="signer-org-line">
                      ${escapeHtml(cert.organization || 'Universidad Privada Domingo Savio')} 
                      ${cert.unit ? '· ' + escapeHtml(cert.unit) : ''}
                      ${cert.email ? '· <a href="mailto:' + escapeHtml(cert.email) + '" style="color:#0f3d6e;">' + escapeHtml(cert.email) + '</a>' : ''}
                    </div>
                  </div>
                </div>

                <!-- MÉTRICAS CRIPTOGRÁFICAS CLAVE -->
                <div class="audit-metric-grid">
                  <div class="audit-badge-box">
                    <span class="badge-lbl">Integridad (Hash SHA-256):</span>
                    <span class="${s.integrity ? 'status-ok' : 'status-bad'}">
                      ${s.integrity ? '✅ Inalterado (ByteRange Válido)' : '❌ Alterado post-firma'}
                    </span>
                  </div>
                  <div class="audit-badge-box">
                    <span class="badge-lbl">Firma Criptográfica:</span>
                    <span class="${s.signature ? 'status-ok' : 'status-bad'}">
                      ${s.signature ? '✅ Criptografía RSA Correcta' : '❌ Resumen o clave no coinciden'}
                    </span>
                  </div>
                  <div class="audit-badge-box">
                    <span class="badge-lbl">Cadena de Confianza:</span>
                    <span class="${s.trusted ? 'status-ok' : 'status-bad'}">
                      ${s.trusted ? '🏛️ CA Raíz UPDS (Confiable)' : '⚠️ CA No Instalada en Almacén'}
                    </span>
                  </div>
                </div>

                <!-- METADATOS DEL ACTO DE FIRMA -->
                <div style="margin-top:14px;">
                  <div class="sig-info-table-grid">
                    <div class="sig-info-item">
                      <span class="info-k">Motivo / Razón:</span>
                      <span class="info-v">${escapeHtml(meta.reason || 'Conformidad técnica')}</span>
                    </div>
                    <div class="sig-info-item">
                      <span class="info-k">Lugar / Sede:</span>
                      <span class="info-v">${escapeHtml(meta.location || 'La Paz, Bolivia')}</span>
                    </div>
                    <div class="sig-info-item">
                      <span class="info-k">Fecha de Firma (M):</span>
                      <span class="info-v">${escapeHtml(meta.signing_date || 'Registrada en CMS')}</span>
                    </div>
                    <div class="sig-info-item">
                      <span class="info-k">Contacto Registrado:</span>
                      <span class="info-v">${escapeHtml(meta.contact || signerName)}</span>
                    </div>
                  </div>
                </div>

                <!-- DETALLES TÉCNICOS DEL CERTIFICADO X.509 -->
                ${cert.serial_hex ? `
                  <div class="sig-cert-details-box">
                    <div class="cert-detail-title">📜 Certificado Digital X.509 v3 Asociado:</div>
                    <div class="cert-detail-grid">
                      <div><b>Emisor (Issuer CA):</b> ${escapeHtml(cert.issuer_cn || 'Autoridad Certificadora Raíz UPDS')}</div>
                      <div><b>Algoritmo:</b> RSA ${cert.key_size || 2048} bits (SHA-256)</div>
                      <div><b>Número de Serie:</b> <code style="font-size:11px;">${cert.serial_hex}</code></div>
                      <div><b>Vigencia:</b> ${(cert.valid_from || '').substring(0, 10)} hasta ${(cert.valid_to || '').substring(0, 10)}</div>
                      <div style="grid-column: 1 / -1;"><b>Huella Digital (Fingerprint SHA-256):</b> <code style="font-size:11px;">${cert.fingerprint_sha256 || 'N/A'}</code></div>
                    </div>
                  </div>
                ` : ''}

                <!-- DICTAMEN TÉCNICO LOCAL -->
                <div style="margin-top:12px;font-size:12px;color:#475569;line-height:1.5;background:#f8fafc;padding:10px 14px;border-radius:6px;border:1px solid var(--border);">
                  <b>Dictamen técnico local:</b> ${escapeHtml(s.explanation)}
                </div>

                <!-- RESPALDO OFICIAL DE VALIDAR.FIRMADIGITAL.BO -->
                ${renderOfficialAdsibBox(adsib, s)}
              </div>
            `;
          });
          container.innerHTML = html;
        }
        container.style.display = 'block';
      } catch (err) {
        window.showToast('Error de Validación', err.message, 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<span class="btn-icon">🔍</span><span class="btn-label">Auditar Documento y Ver Firmante</span>';
      }
    }

    // RENDER DEL BLOQUE OFICIAL AGETIC / ADSIB (validar.firmadigital.bo)
    function renderOfficialAdsibBox(adsib, s) {
      if (!adsib) {
        return `
          <div class="official-adsib-box info-mode">
            <div class="adsib-header">
              <div style="display:flex;align-items:center;gap:10px;">
                <span class="adsib-flag">🇧🇴</span>
                <div>
                  <strong style="color:var(--primary);font-size:13px;">Servicio de Validación Oficial del Estado (validar.firmadigital.bo)</strong>
                  <div class="adsib-sub" style="color:var(--text-muted);">Agencia de Gobierno Electrónico y Tecnologías de Información (AGETIC / ADSIB)</div>
                </div>
              </div>
              <a href="https://validar.firmadigital.bo" target="_blank" rel="noopener" class="btn-link-external">
                Abrir portal oficial ↗
              </a>
            </div>
            <p class="adsib-trust-note" style="color:var(--text-muted);margin:0;">
              El servicio central de verificación en línea está disponible para comprobación externa. Puedes subir este archivo directamente a <b>validar.firmadigital.bo</b> para corroborar de forma independiente la integridad y el reconocimiento del estándar PAdES.
            </p>
          </div>
        `;
      }

      const certAdsib = adsib.certificado || {};
      const detalle = adsib.detalleValidacion || {};

      const adsibSigner = certAdsib.nombreSignatario || detalle.certificadoTitular || adsib.nombreSignatario || s.signer_name || 'Desconocido';
      const docEstado = detalle.documentoEstado || adsib.documentoEstado || (adsib.noModificado ? 'Documento auténtico' : 'Documento modificado');
      const docValidacion = detalle.documentoValidacion || adsib.documentoValidacion || (adsib.noModificado ? 'EXITO' : 'ERROR');
      const docDescripcion = detalle.documentoDescripcion || adsib.documentoDescripcion || '';
      const periodVal = detalle.periodoValidezValidacion || adsib.periodoValidezValidacion || 'EXITO';
      const certVal = detalle.certificadoValidacion || adsib.certificadoValidacion || 'ADVERTENCIA';

      const docOk = (adsib.noModificado !== false) && (docValidacion !== 'ERROR');
      const periodOk = periodVal === 'EXITO';

      return `
        <div class="official-adsib-box" style="${!docOk ? 'background:#fef2f2;border-color:#fca5a5;border-left-color:#ef4444;' : ''}">
          <div class="adsib-header">
            <div style="display:flex;align-items:center;gap:10px;">
              <span class="adsib-flag">🇧🇴</span>
              <div>
                <strong style="color:${docOk ? '#78350f' : '#991b1b'};font-size:13px;">Respaldo Oficial del Estado Plurinacional de Bolivia</strong>
                <div class="adsib-sub" style="color:${docOk ? '#78350f' : '#b91c1c'};">Dictamen emitido por AGETIC / ADSIB vía validar.firmadigital.bo</div>
              </div>
            </div>
            <a href="https://validar.firmadigital.bo" target="_blank" rel="noopener" class="btn-link-external" style="${!docOk ? 'color:#991b1b;' : ''}">
              🌐 Portal validar.firmadigital.bo ↗
            </a>
          </div>

          <div class="adsib-grid" style="${!docOk ? 'background:rgba(254, 226, 226, 0.6);color:#7f1d1d;' : ''}">
            <div>
              <b>Signatario Reconocido:</b><br>
              <span style="font-weight:700;">${escapeHtml(adsibSigner)}</span>
              ${certAdsib.organizacionSignatario ? `<br><small style="color:${docOk ? '#78350f' : '#7f1d1d'};">${escapeHtml(certAdsib.organizacionSignatario)}</small>` : ''}
            </div>
            <div>
              <b>Estado del Documento:</b><br>
              <span style="font-weight:700;color:${docOk ? '#065f46' : '#991b1b'};">
                ${docOk ? '✅ ' + escapeHtml(docEstado) : '❌ ' + escapeHtml(docEstado)}
              </span>
            </div>
            <div>
              <b>Periodo de Validez:</b><br>
              <span style="font-weight:700;color:${periodOk ? '#065f46' : '#991b1b'};">
                ${periodOk ? '✅ En vigencia legal' : '⚠️ ' + escapeHtml(periodVal)}
              </span>
            </div>
            <div>
              <b>Evaluación de Certificado:</b><br>
              <span>${escapeHtml(certVal)} (CA Privada / Académica)</span>
            </div>
          </div>

          <div class="adsib-trust-note" style="${!docOk ? 'color:#991b1b;' : ''}">
            ${docOk 
              ? `ℹ️ <b>Diagnóstico oficial:</b> ${escapeHtml(docDescripcion || 'El documento no ha sido modificado después de la firma.')} La plataforma estatal verifica y certifica que la estructura PAdES y el resumen matemático son 100% auténticos. Al ser una CA Raíz Académica UPDS, el Estado emite advertencia de confianza porque la raíz no está en la TSL oficial de la ATT.`
              : `🚨 <b>Ruptura de Integridad Confirmada por el Estado:</b> ${escapeHtml(docDescripcion || 'El documento ha sido modificado después de la firma.')} El Estado Plurinacional de Bolivia declara la firma INVÁLIDA.`
            }
          </div>

          ${!docOk ? `
            <div style="margin-top:12px;background:#ffffff;border:1.5px dashed #dc2626;border-radius:8px;padding:12px 16px;font-size:12px;color:#991b1b;line-height:1.5;">
              <strong style="display:block;font-size:13px;margin-bottom:4px;">🔍 ¿Por qué no lo ves a simple vista en validar.firmadigital.bo?</strong>
              En el diseño de la web estatal de la AGETIC, el estado de integridad está <b>colapsado por defecto</b>. Para verlo:<br>
              1. En la tarjeta con el nombre del firmante, haz clic en el botón <b>"VER DETALLE"</b> (esquina derecha).<br>
              2. Se desplegará la lista de 4 verificaciones. El <b>punto 1</b> aparecerá con una insignia roja: <b>❌ Documento modificado</b> y el texto <i>"El documento ha sido modificado después de la firma"</i>.<br>
              3. En el PDF original sin alterar, ese mismo punto 1 aparece con una insignia verde: <b>✅ Documento auténtico</b>.
            </div>
          ` : ''}
        </div>
      `;
    }

    // SIMULADOR DE ALTERACIÓN / TAMPERING
    async function executeTamperAndAudit() {
      let fileToTamper = selectedVerifyPdfFile;
      if (!fileToTamper && signedPdfBlob) {
        fileToTamper = new File([signedPdfBlob], signedPdfFileName, { type: 'application/pdf' });
      }

      if (!fileToTamper) {
        window.showToast('Falta Archivo', 'Selecciona un archivo PDF firmado primero para probar la alteración.', 'warning');
        return;
      }

      const btn = document.getElementById('btn-tamper-run');
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '⏳ Corrompiendo byte en ByteRange...';
      }

      try {
        const fd = new FormData();
        fd.append('pdf', fileToTamper);

        const res = await fetch('/api/tamper', {
          method: 'POST',
          body: fd
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({ error: 'Error al alterar PDF' }));
          throw new Error(err.error || 'Error al alterar');
        }

        const blob = await res.blob();
        const baseName = fileToTamper.name.replace(/\.[^/.]+$/, "");
        const tamperedName = baseName + '_ALTERADO.pdf';
        const tamperedFile = new File([blob], tamperedName, { type: 'application/pdf' });

        // Auto-descargar la copia alterada para que el usuario la tenga en su carpeta de Descargas
        const dlUrl = URL.createObjectURL(blob);
        const dlA = document.createElement('a');
        dlA.href = dlUrl;
        dlA.download = tamperedName;
        dlA.click();
        URL.revokeObjectURL(dlUrl);

        // Asignar al validador y actualizar UI
        applyVerifyPdfFile(tamperedFile);

        window.showToast(
          '🧪 PDF Alterado y Descargado',
          `Se descargó "${tamperedName}". En validar.firmadigital.bo haz clic en el botón "VER DETALLE" para ver el punto "Documento modificado".`,
          'warning',
          7000
        );

        // Ejecutar auditoría automáticamente para ver el fallo
        await executeVerifyPdf();
      } catch (e) {
        window.showToast('Error en alterador', e.message, 'error');
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = '⚡ Alterar este PDF y Auditar de inmediato';
        }
      }
    }

    async function executeTamperDownload() {
      let fileToTamper = selectedVerifyPdfFile;
      if (!fileToTamper && signedPdfBlob) {
        fileToTamper = new File([signedPdfBlob], signedPdfFileName, { type: 'application/pdf' });
      }

      if (!fileToTamper) {
        window.showToast('Falta Archivo', 'Selecciona un archivo PDF firmado primero para generar la copia alterada.', 'warning');
        return;
      }

      const btn = document.getElementById('btn-tamper-dl');
      if (btn) {
        btn.disabled = true;
        btn.innerHTML = '⏳ Descargando copia alterada...';
      }

      try {
        const fd = new FormData();
        fd.append('pdf', fileToTamper);

        const res = await fetch('/api/tamper', {
          method: 'POST',
          body: fd
        });

        if (!res.ok) {
          throw new Error('Error al generar PDF alterado');
        }

        const blob = await res.blob();
        const baseName = fileToTamper.name.replace(/\.[^/.]+$/, "");
        const tamperedName = baseName + '_ALTERADO.pdf';

        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = tamperedName;
        a.click();
        URL.revokeObjectURL(url);

        window.showToast(
          'Archivo Descargado',
          `Se descargó "${tamperedName}". Puedes subirlo a https://validar.firmadigital.bo para comprobar que el Estado lo detecta modificado.`,
          'success',
          6000
        );
      } catch (e) {
        window.showToast('Error', e.message, 'error');
      } finally {
        if (btn) {
          btn.disabled = false;
          btn.innerHTML = '⬇️ Descargar copia alterada (.pdf)';
        }
      }
    }

    async function tamperSignedPdfAndAudit() {
      if (!signedPdfBlob) return;
      const file = new File([signedPdfBlob], signedPdfFileName, { type: 'application/pdf' });
      applyVerifyPdfFile(file);
      goToTab('verify');
      await executeTamperAndAudit();
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    // CARGAR BITÁCORA DE AUDITORÍA
    async function loadUserAuditLogs() {
      const msg = document.getElementById('audit-loading-msg');
      const table = document.getElementById('audit-logs-table');
      const tbody = document.getElementById('audit-logs-tbody');
      if (!msg || !table || !tbody) return;

      try {
        const res = await fetch('/api/auth/activity');
        const data = await res.json();
        if (data.ok && data.logs && data.logs.length > 0) {
          tbody.innerHTML = '';
          data.logs.forEach(log => {
            const tr = document.createElement('tr');
            const dateStr = new Date(log.created_at).toLocaleString();
            const actionBadge = log.action === 'SIGN_PDF' 
              ? '<span class="badge-tag badge-success">Firma PAdES</span>'
              : log.action === 'REGISTER'
              ? '<span class="badge-tag badge-info">Emisión Cert</span>'
              : `<span class="badge-tag badge-info">${log.action}</span>`;
            
            const hashShort = log.file_hash ? log.file_hash.substring(0, 16) + '...' : '-';
            tr.innerHTML = `
              <td>${dateStr}</td>
              <td>${actionBadge} · ${log.details || ''}</td>
              <td><b>${log.filename || '-'}</b></td>
              <td><code style="font-size:11px;background:#f1f5f9;padding:2px 4px;border-radius:3px;">${hashShort}</code></td>
            `;
            tbody.appendChild(tr);
          });
          msg.style.display = 'none';
          table.style.display = 'table';
        } else {
          msg.textContent = 'Aún no tienes documentos firmados en tu bitácora.';
          msg.style.display = 'block';
          table.style.display = 'none';
        }
      } catch (e) {
        msg.textContent = 'No se pudo cargar la bitácora de auditoría.';
      }
    }

    // Inicializaciones al cargar la página
    window.addEventListener('DOMContentLoaded', () => {
      initCanvas();
      checkUserAuth();
    });
  </script>
</BaseLayout>
